# Application
APP_NAME=VisionInspect AI
ENVIRONMENT=development

# Security
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (SQLite for local dev; swap for Postgres in production)
DATABASE_URL=sqlite:///./visioninspect.db
# DATABASE_URL=postgresql://user:password@localhost:5432/visioninspect

# Uploads
UPLOAD_DIR=app/uploads
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/bmp,image/tiff,image/webp

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
